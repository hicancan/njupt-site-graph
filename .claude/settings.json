{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m sitegraph.cli *)",
      "Bash(pytest *)",
      "Bash(python -m pip install -e .*)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "WebFetch(domain:jwc.njupt.edu.cn)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(Invoke-WebRequest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(D:/code/github/hicancan/njupt-search/.env*)"
    ],
    "additionalDirectories": [
      "D:/code/github/hicancan/static-site-graph",
      "D:/code/github/hicancan/njupt-search"
    ]
  }
}
